# Copy to .env.local (git-ignored) and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# These web config values identify the project; they are not server secrets.
# NEVER put a service-account private key here.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id

# Unadvertised address of the Register page. Pick your own hard-to-guess value, e.g. /join-<random>
# (generate one with: echo "/join-$(openssl rand -hex 8)"). Leave empty to have no register page.
# Not a security control: anyone can still find it in the app's JavaScript.
VITE_REGISTER_PATH=

# Spring Boot API. Leave empty: the app then calls /api on its own address and the Vite dev server
# forwards to http://localhost:8080, which also works from other devices / port forwarding.
# Only set a full URL if the API runs somewhere else (it must then allow this origin via APP_CORS_ORIGIN).
VITE_API_BASE_URL=
